{
  "name": "@whiteslove/geo-catalog",
  "version": "0.9.15",
  "description": "Structured geographic catalog for cities, districts, neighborhoods, residential complexes, transit and POIs with coordinates, bounds and OSM metadata.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmoneMisa/geo-catalog.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./runtime-index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime-index.d.ts",
      "import": "./src/index.js"
    },
    "./catalog": {
      "types": "./index.d.ts",
      "import": "./src/catalog.js"
    },
    "./spatial": {
      "types": "./index.d.ts",
      "import": "./src/spatial.js"
    },
    "./validate": {
      "types": "./index.d.ts",
      "import": "./src/validate.js"
    },
    "./lexicon-bridge": {
      "types": "./runtime-index.d.ts",
      "import": "./src/lexicon-runtime-bridge.js"
    },
    "./lookup-key": {
      "types": "./index.d.ts",
      "import": "./src/lookup-key.js"
    },
    "./transport": {
      "types": "./transport.d.ts",
      "import": "./src/transport/catalog.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "runtime-index.d.ts",
    "transport.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:catalog": "node ./scripts/build-encrypted-catalog.js",
    "pretest": "npm run build:catalog",
    "test": "node --test --test-concurrency=4",
    "validate": "node ./scripts/validate-catalog.js",
    "audit:lexicon": "node ./scripts/audit-lexicon-coverage.js",
    "audit:transport": "node ./scripts/audit-transport-coverage.js",
    "enrich:geofabrik": "node ./scripts/enrich-geofabrik-country.js",
    "review:geofabrik": "node ./scripts/prepare-geofabrik-review.js",
    "review:cached-map-poi": "node ./scripts/prepare-geofabrik-review.js --profile map-poi",
    "enrich:geofabrik:all": "node ./scripts/enrich-geofabrik-all-countries.js",
    "review:cached-map-data": "node ./scripts/prepare-map-data-reviews.js",
    "apply:cached-map-data": "node ./scripts/generate-map-data-module.js --approve",
    "prepack": "npm test && npm run validate && npm run audit:lexicon"
  },
  "devDependencies": {
    "@whiteslove/parsing-lexicon": "^0.9.3"
  },
  "keywords": [
    "geography",
    "geospatial",
    "coordinates",
    "openstreetmap",
    "osm",
    "cities",
    "districts",
    "transit",
    "poi",
    "parsing-lexicon"
  ],
  "license": "MIT"
}
