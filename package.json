{
  "name": "@whiteslove/geo-catalog",
  "version": "0.4.0",
  "description": "Structured geographic catalog for cities, districts, neighborhoods, residential complexes, transit and POIs with coordinates, bounds and OSM metadata.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmoneMisa/geo-catalog.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./src/index.js" },
    "./catalog": { "types": "./index.d.ts", "import": "./src/catalog.js" },
    "./spatial": { "types": "./index.d.ts", "import": "./src/spatial.js" },
    "./validate": { "types": "./index.d.ts", "import": "./src/validate.js" },
    "./lexicon-bridge": { "types": "./index.d.ts", "import": "./src/lexicon-bridge.js" },
    "./lookup-key": { "types": "./index.d.ts", "import": "./src/lookup-key.js" }
  },
  "files": ["src", "index.d.ts", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "validate": "node ./scripts/validate-catalog.js",
    "audit:lexicon": "node ./scripts/audit-lexicon-coverage.js",
    "prepack": "npm test && npm run validate"
  },
  "devDependencies": {
    "@whiteslove/parsing-lexicon": "github:AmoneMisa/parsing-lexicon#master"
  },
  "keywords": ["geography", "geospatial", "coordinates", "openstreetmap", "osm", "cities", "districts", "transit", "poi", "parsing-lexicon"],
  "license": "MIT"
}
