{
  "name": "@whiteslove/geo-catalog",
  "version": "0.7.7",
  "description": "Structured geographic catalog for cities, districts, neighborhoods, residential complexes, transit and POIs with coordinates, bounds and OSM metadata.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmoneMisa/geo-catalog.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./catalog": {
      "types": "./index.d.ts",
      "import": "./src/catalog.js"
    },
    "./spatial": {
      "types": "./index.d.ts",
      "import": "./src/spatial.js"
    },
    "./validate": {
      "types": "./index.d.ts",
      "import": "./src/validate.js"
    },
    "./lexicon-bridge": {
      "types": "./index.d.ts",
      "import": "./src/lexicon-bridge.js"
    },
    "./lookup-key": {
      "types": "./index.d.ts",
      "import": "./src/lookup-key.js"
    },
    "./transport": {
      "types": "./transport.d.ts",
      "import": "./src/transport/catalog.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "transport.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node ./scripts/validate-catalog.js",
    "audit:lexicon": "node ./scripts/audit-lexicon-coverage.js",
    "audit:transport": "node ./scripts/audit-transport-coverage.js",
    "prepack": "npm test && npm run validate"
  },
  "devDependencies": {
    "@whiteslove/parsing-lexicon": "0.6.11"
  },
  "keywords": [
    "geography",
    "geospatial",
    "coordinates",
    "openstreetmap",
    "osm",
    "cities",
    "districts",
    "transit",
    "poi",
    "parsing-lexicon"
  ],
  "license": "MIT"
}
