# Optional provider credentials for `npm run crawl:geo`.
# Copy this file to .env and keep real values local.
BUSMAPS_API_KEY=
# WIKIROUTES_API_KEY=  # alternative to BUSMAPS_API_KEY
GOOGLE_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
DGIS_API_KEY=
MAPTILER_API_KEY=
GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Storage opt-ins remain explicit and are off by default.
# GOOGLE_ALLOW_STORAGE=1
# YANDEX_ALLOW_STORAGE=1
# DGIS_ALLOW_STORAGE=1
# MAPTILER_ALLOW_STORAGE=1
# GEOAPIFY_ALLOW_STORAGE=1
# MAPBOX_PERMANENT=1
